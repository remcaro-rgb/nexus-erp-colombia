  "mediated_overlaps": [
    {
      "paths": [
        "contracts/**",
        "contracts/openapi/modules/*",
        "contracts/events/*",
        "contracts/dataio/**"
      ],
      "rule": "P02 owns contracts/** until G0; afterwards each module owns only its own fragments; anything else is a CCR resolved by M5 (P00)."
    },
    {
      "paths": [
        "tests/contract/**"
      ],
      "rule": "P02 owns schema tests; P22 (M5) only runs them."
    },
    {
      "paths": [
        "deploy/**",
        "deploy/keycloak/realm-template.json"
      ],
      "rule": "P04 owns the realm template file; compose wiring stays P03 via CCR."
    },
    {
      "paths": [
        "tests/regulatory/**",
        "tests/regulatory/payroll/**",
        "tests/regulatory/map.yaml"
      ],
      "rule": "P06 owns tests/regulatory/** except payroll/ (P13) and map.yaml (P23)."
    },
    {
      "paths": [
        "docs/compliance/**",
        "docs/compliance/parameter-verification.md",
        "docs/compliance/annex-versions.md"
      ],
      "rule": "P23 owns docs/compliance/** except the P06 and P15 files, which P23 only reviews."
    },
    {
      "paths": [
        "backend/kernel/**",
        "backend/kernel/fixtures/demo_tenant.yaml"
      ],
      "rule": "P21 owns the demo tenant data file; loader code stays P01."
    },
    {
      "paths": [
        "contracts/permissions/catalog.yaml"
      ],
      "rule": "Append-only: each module adds only its own <module>.* codes; M5 checks the diff."
    }
  ],
  "common_paths_per_task": [
    "docs/handoffs/{prompt}.md",
    "contracts/change-requests/{prompt}-*",
    "contracts/change-requests/DEP-{prompt}-*",
    "contracts/permissions/catalog.yaml"
  ],
  "m5_only_paths": [
    "docs/adr/**",
    "docs/gates/**",
    "docs/STATUS.md",
    "docs/five-machine/**",
    "docs/prompt-pack/**"
  ]
}
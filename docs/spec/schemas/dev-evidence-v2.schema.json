{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erp-five-machine-dev/dev-evidence/v2",
  "title": "DEV runtime evidence recorded by M5 in the DEV accept event (structure only; erpctl validate-dev-evidence enforces semantics: commit = RC = accepted head, image digests = RC, URL/port = config, fresh HTTP check, no secrets) — v2 (2.2.0-dev runs: Playwright and portal logins mandatory, screenshots, feature results)",
  "type": "object",
  "required": [
    "schema",
    "commit",
    "images",
    "compose_project",
    "compose_files_digest",
    "bind_host",
    "port",
    "public_origin",
    "port_conflict_detected",
    "local_url",
    "http_check",
    "checks",
    "restart_policy",
    "volumes",
    "synthetic_data_only",
    "unknown_parameters_fail_closed",
    "integrations",
    "authz_checks",
    "repo_path",
    "credentials_file",
    "credentials_in_git",
    "logs_path",
    "test_reports",
    "screenshots",
    "feature_results"
  ],
  "properties": {
    "schema": {
      "const": "erp-five-machine-dev/dev-evidence/v2"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "compose_project": {
      "type": "string"
    },
    "compose_files_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bind_host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "public_origin": {
      "type": "string"
    },
    "port_conflict_detected": {
      "const": false
    },
    "local_url": {
      "type": "string",
      "pattern": "^http://(localhost|127\\.0\\.0\\.1|[^/]+):[0-9]+/$"
    },
    "http_check": {
      "type": "object",
      "required": [
        "url",
        "status",
        "checked_at"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 399
        },
        "checked_at": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "compose_config",
        "port_preflight",
        "images_match_rc",
        "compose_up",
        "migrations",
        "seed",
        "proxy_health",
        "backend_live",
        "backend_ready",
        "frontend_root",
        "dev_banner",
        "oidc_discovery",
        "login_page",
        "api_anonymous_denied",
        "mcp_anonymous_denied",
        "worker_health",
        "db_health",
        "e2e_synthetic_transaction",
        "browser_login_smoke",
        "portal_login_supplier",
        "portal_login_customer",
        "portal_login_employee",
        "print_pdf_smoke",
        "visual_regression",
        "a11y",
        "noncert_labels_visible"
      ],
      "properties": {
        "compose_config": {
          "const": "PASSED"
        },
        "port_preflight": {
          "const": "PASSED"
        },
        "images_match_rc": {
          "const": "PASSED"
        },
        "compose_up": {
          "const": "PASSED"
        },
        "migrations": {
          "const": "PASSED"
        },
        "seed": {
          "const": "PASSED"
        },
        "proxy_health": {
          "const": "PASSED"
        },
        "backend_live": {
          "const": "PASSED"
        },
        "backend_ready": {
          "const": "PASSED"
        },
        "frontend_root": {
          "const": "PASSED"
        },
        "dev_banner": {
          "const": "PASSED"
        },
        "oidc_discovery": {
          "const": "PASSED"
        },
        "login_page": {
          "const": "PASSED"
        },
        "api_anonymous_denied": {
          "const": "PASSED"
        },
        "mcp_anonymous_denied": {
          "const": "PASSED"
        },
        "worker_health": {
          "const": "PASSED"
        },
        "db_health": {
          "const": "PASSED"
        },
        "e2e_synthetic_transaction": {
          "const": "PASSED"
        },
        "browser_login_smoke": {
          "const": "PASSED"
        },
        "portal_login_supplier": {
          "const": "PASSED"
        },
        "portal_login_customer": {
          "const": "PASSED"
        },
        "portal_login_employee": {
          "const": "PASSED"
        },
        "print_pdf_smoke": {
          "const": "PASSED"
        },
        "visual_regression": {
          "const": "PASSED"
        },
        "a11y": {
          "const": "PASSED"
        },
        "noncert_labels_visible": {
          "const": "PASSED"
        }
      }
    },
    "restart_policy": {
      "const": "unless-stopped"
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "persistent"
        ],
        "properties": {
          "persistent": {
            "const": true
          }
        }
      }
    },
    "synthetic_data_only": {
      "const": true
    },
    "unknown_parameters_fail_closed": {
      "const": true
    },
    "integrations": {
      "type": "object",
      "required": [
        "email",
        "payments",
        "banks",
        "dian",
        "pila",
        "llm"
      ],
      "additionalProperties": false,
      "properties": {
        "email": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        },
        "payments": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        },
        "banks": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        },
        "dian": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        },
        "pila": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        },
        "llm": {
          "enum": [
            "DISABLED",
            "FIXTURE_NOT_CERTIFIED",
            "LOCAL_CAPTURE",
            "SANDBOX"
          ]
        }
      }
    },
    "authz_checks": {
      "type": "object",
      "required": [
        "api_anonymous_denied",
        "mcp_anonymous_denied",
        "field_policy_enforced",
        "ai_agent_uses_delegated_user"
      ]
    },
    "repo_path": {
      "type": "string"
    },
    "credentials_file": {
      "type": "string",
      "description": "PATH ONLY, never contents"
    },
    "credentials_in_git": {
      "const": false
    },
    "logs_path": {
      "type": "string"
    },
    "test_reports": {
      "type": "array",
      "minItems": 1
    },
    "screenshots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "feature_results": {
      "$ref": "../features/results/v1"
    }
  }
}

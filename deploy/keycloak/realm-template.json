  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@nexus-erp.invalid",
    "fromDisplayName": "NexusERP DEV",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "users": []

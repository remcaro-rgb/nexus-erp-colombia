{
  "uid": "nexus-llm",
  "title": "Nexus ERP \u2014 LLM cost per tenant",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "nexus-erp",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "cost per tenant (COP, from provider usage)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (increase(erp_llm_cost_cop_total[1d]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "tokens per tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id, direction) (increase(erp_llm_tokens_total[1d]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "tool calls denied by policy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(erp_ai_tool_denied_total[1d]))"
        }
      ]
    }
  ]
}

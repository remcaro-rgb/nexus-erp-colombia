{
  "uid": "nexus-dian",
  "title": "Nexus ERP \u2014 DIAN gateway status (SIMULADO in dev)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "nexus-erp",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "gateway mode (1 = FIXTURE_NOT_CERTIFIED)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (mode) (erp_dian_gateway_mode)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "documents by fiscal status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (erp_dian_documents_total)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "contingency mode active",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(erp_dian_contingency_active)"
        }
      ]
    }
  ]
}

{
  "uid": "nexus-outbox",
  "title": "Nexus ERP \u2014 outbox lag",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "nexus-erp",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "oldest unpublished event age (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (company_id) (erp_outbox_oldest_pending_age_seconds)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "pending events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (erp_outbox_pending_events)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "publish failures/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(erp_outbox_publish_failures_total[5m]))"
        }
      ]
    }
  ]
}

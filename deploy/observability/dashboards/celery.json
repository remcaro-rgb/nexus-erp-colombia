{
  "uid": "nexus-celery",
  "title": "Nexus ERP \u2014 Celery queue depth",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "nexus-erp",
    "dev"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (erp_celery_queue_length)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "task failures/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (rate(erp_celery_task_failures_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "task runtime p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, task_name) (rate(erp_celery_task_runtime_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
